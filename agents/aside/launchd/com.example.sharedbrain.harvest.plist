<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.sharedbrain.harvest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/me/sharedbrain/agents/aside/harvest-run.sh</string>
  </array>

  <!-- 매일 09:00. 그 시각에 맥이 자고 있으면 깨어날 때, 꺼져 있었으면 다음 부팅 뒤에 한 번 돈다. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/me/.nvm/versions/node/vXX/bin:/Users/me/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/me</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/me/.sharedbrain/harvest.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/me/.sharedbrain/harvest.launchd.log</string>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
